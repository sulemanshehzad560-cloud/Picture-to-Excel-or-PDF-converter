{
  "name": "omniscan",
  "version": "1.0.0",
  "private": true,
  "description": "OmniScan: turn photos of any document, including handwriting, into Excel, Word or PDF. Fully offline.",
  "type": "module",
  "scripts": {
    "models": "node scripts/fetch-models.mjs",
    "dev": "vite",
    "build": "node scripts/fetch-models.mjs && vite build",
    "preview": "vite preview",
    "test": "node --test web/tests/*.test.js",
    "bench": "node scripts/bench.mjs",
    "android:sync": "npm run build && npx cap sync android"
  },
  "license": "UNLICENSED",
  "dependencies": {
    "@capacitor/android": "^8.5.2",
    "@capacitor/camera": "^8.2.4",
    "@capacitor/core": "^8.5.2",
    "@capacitor/filesystem": "^8.1.3",
    "@capacitor/share": "^8.0.2",
    "@capacitor/splash-screen": "^8.0.2",
    "@capacitor/status-bar": "^8.0.3",
    "@fontsource/jetbrains-mono": "^5.3.0",
    "@fontsource/space-grotesk": "^5.3.0",
    "@techstark/opencv-js": "^5.0.0-release.1",
    "docx": "^9.8.1",
    "exceljs": "^4.4.0",
    "jszip": "^3.10.2",
    "onnxruntime-web": "^1.30.0",
    "pdfjs-dist": "^5.7.284",
    "pdfmake": "^0.3.11"
  },
  "devDependencies": {
    "@capacitor/assets": "^3.0.5",
    "@capacitor/cli": "^8.5.2",
    "pngjs": "^7.0.0",
    "vite": "^8.3.1"
  }
}
